# Copy to .env and fill in. .env is git-ignored and must never be committed.
#   cp .env.example .env

# --- InfluxDB 2.x ------------------------------------------------------------
INFLUXDB_USERNAME=admin
# Required. At least 8 characters.
INFLUXDB_PASSWORD=
# Required. Generate one: openssl rand -hex 32
INFLUXDB_TOKEN=
INFLUXDB_ORG=saint-gobain
INFLUXDB_BUCKET=printer_monitoring
# 0 means infinite retention. Set a duration such as 365d in production.
INFLUXDB_RETENTION=0
INFLUXDB_PORT=8086

# --- grafana -----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
# Required. Generate one:  openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000

# --- broker ------------------------------------------------------------------
MQTT_PORT=1883
MQTT_WS_PORT=9001

# --- identity of the monitored asset ----------------------------------------
# Used by the simulator and by the MQTT topic namespace.
SITE_ID=SaintGobain_SiteX
LINE_ID=L1
PRINTER_ID=CIJ_Printer_L1

# --- notifier (phase 4b) -----------------------------------------------------
# Comma-separated: console,telegram,email,teams
NOTIFY_CHANNELS=console
NOTIFIER_PORT=8080

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=

TEAMS_WEBHOOK_URL=

# open-wa bridge — DEMO ONLY, read notifier/README.md first.
# Needs a separate open-wa server:
#   npx @open-wa/wa-automate --api-host 0.0.0.0 --port 8085 --key <KEY>
OPENWA_URL=
OPENWA_CHAT_ID=
OPENWA_API_KEY=

# --- simulator ---------------------------------------------------------------
PUBLISH_INTERVAL_S=5
# 60 = one real minute is one simulated hour. Without acceleration a demo shows
# nothing, since ink drains at 0.8 %/hour.
TIME_ACCEL=60
PRINTER_VENDOR=Markem-Imaje
PRINTER_MODEL=9450c
EXTERNAL_CARTRIDGE_ML=800
INTERNAL_TANK_ML=1075
INTERNAL_TANK_FULL_MM=100
INTERNAL_RESERVE_HOURS=24
MOTOR_SPEED_RPM=3000

# --- Node-RED ingestion (phase 3) --------------------------------------------
NODE_RED_PORT=1880
NODE_RED_ADMIN_USER=admin
# Required. Generate one: openssl rand -base64 18
NODE_RED_ADMIN_PASSWORD=
# Required. Generate one: openssl rand -base64 32
NODE_RED_CREDENTIAL_SECRET=
NODE_RED_LOG_LEVEL=info

# --- misc --------------------------------------------------------------------
TZ=Africa/Casablanca
