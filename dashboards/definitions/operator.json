      },
      "fieldConfig": {
        "defaults": {
          "displayName": "Pare-brise",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 0
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"printer_monitoring\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"marking_event\" and r._field == \"message_id\")\n  |> group()\n  |> aggregateWindow(every: 5m, fn: count, createEmpty: false)\n  |> map(fn: (r) => ({_time: r._time, _value: r._value}))",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          }
